<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Guideline horizontal al 50% -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_h"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Guideline para barra de controles -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.88" />

    <!-- Camara trasera (arriba) -->
    <TextureView
        android:id="@+id/texture_back"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guideline_h"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Camara frontal (abajo) -->
    <TextureView
        android:id="@+id/texture_front"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/guideline_h"
        app:layout_constraintBottom_toTopOf="@id/guideline_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Divisor visual entre camaras -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="@id/guideline_h"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Etiqueta camara trasera -->
    <TextView
        android:id="@+id/label_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TRASERA"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:background="#66000000"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp" />

    <!-- Etiqueta camara frontal -->
    <TextView
        android:id="@+id/label_front"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FRONTAL"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:background="#66000000"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        app:layout_constraintTop_toBottomOf="@id/guideline_h"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp" />

    <!-- Overlay de filtro (encima de todo el preview) -->
    <View
        android:id="@+id/filter_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.3"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guideline_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Capa de stickers (encima de camaras) -->
    <com.dualcam.StickerView
        android:id="@+id/sticker_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guideline_controls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Indicador de grabacion -->
    <TextView
        android:id="@+id/rec_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● REC"
        android:textColor="#FF0000"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="#66000000"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp" />

    <!-- Indicador de filtro activo -->
    <TextView
        android:id="@+id/filter_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NORMAL"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:background="#66000000"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="8dp" />

    <!-- === BARRA DE CONTROLES === -->
    <LinearLayout
        android:id="@+id/controls_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="#CC000000"
        app:layout_constraintTop_toBottomOf="@id/guideline_controls"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fila de filtros (scroll horizontal) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/filters_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp" />
        </HorizontalScrollView>

        <!-- Fila de botones principales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">

            <!-- Boton stickers -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sticker"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="😀"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:strokeColor="#FFFFFF"
                android:layout_marginHorizontal="4dp" />

            <!-- Boton captura foto -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_capture"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="8dp"
                android:backgroundTint="#FFFFFF"
                android:text=""
                app:cornerRadius="32dp" />

            <!-- Boton grabar video -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_record"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏺"
                android:textSize="20sp"
                android:textColor="#FF4444"
                android:strokeColor="#FF4444"
                android:layout_marginHorizontal="4dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
