<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- TRASERA: pantalla completa -->
    <com.dualcam.AutoFitTextureView
        android:id="@+id/texture_back"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Overlay de filtro (encima de cámara trasera) -->
    <View
        android:id="@+id/filter_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.3"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Capa de stickers -->
    <com.dualcam.StickerView
        android:id="@+id/sticker_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- FRONTAL: pequeña flotante circular (draggable, esquina superior derecha) -->
    <com.dualcam.CircleFrameLayout
        android:id="@+id/pip_container"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="#000000"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp">

        <com.dualcam.AutoFitTextureView
            android:id="@+id/texture_front"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleX="1.4"
            android:scaleY="1.4" />

        <!-- Borde circular -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/pip_border" />

    </com.dualcam.CircleFrameLayout>

    <!-- Indicador REC -->
    <TextView
        android:id="@+id/rec_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● REC"
        android:textColor="#FF0000"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="#88000000"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp" />

    <!-- Nombre del filtro activo -->
    <TextView
        android:id="@+id/filter_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NORMAL"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:background="#66000000"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toTopOf="@id/controls_bar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="12dp" />

    <!-- Barra de controles inferior -->
    <LinearLayout
        android:id="@+id/controls_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC000000"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fila de filtros -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/filters_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp" />
        </HorizontalScrollView>

        <!-- Botones principales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sticker"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="😀"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:strokeColor="#FFFFFF"
                android:layout_marginHorizontal="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_capture"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginHorizontal="12dp"
                android:backgroundTint="#FFFFFF"
                android:text=""
                app:cornerRadius="34dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_record"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏺"
                android:textSize="22sp"
                android:textColor="#FF4444"
                android:strokeColor="#FF4444"
                android:layout_marginHorizontal="4dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
